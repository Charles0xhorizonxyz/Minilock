<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#C9AA7C</item>
        <item name="android:windowBackground">#090C10</item>
        <item name="android:navigationBarColor">#090C10</item>
        <item name="android:statusBarColor">#090C10</item>
    </style>
    <style name="LockTheme" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>
</resources>
